# Site Public URL (overrides default https://pescobarseafoodbrussels.be)
NEXT_PUBLIC_SITE_URL=https://pescobarseafoodbrussels.be

# Supabase (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional extra admin emails (comma-separated whitelist)
ADMIN_EMAILS=pescobarbrussels@gmail.com,pescobarseafoodbrussels@gmail.com

# Optional Upstash Redis rate limiting (falls back to in-memory limiter if omitted)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend Email Delivery
RESEND_API_KEY=your-resend-api-key
# Sender: "Pescobar Seafood Bruxelles <onboarding@resend.dev>" or "Pescobar Seafood <reservations@pescobarseafoodbrussels.be>" once domain is verified
RESEND_FROM_EMAIL="Pescobar Seafood Bruxelles <onboarding@resend.dev>"
# Email address receiving admin alerts for reservations and contacts
RESERVATION_ALERT_EMAIL=pescobarseafoodbrussels@gmail.com

# Local UI preview bypass ONLY when NODE_ENV=development (never set in production!)
ALLOW_DEV_ADMIN_BYPASS=false
